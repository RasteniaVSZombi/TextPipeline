<Window x:Class="TextPipeline.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TextPipeline.ViewModels"
        xmlns:conv="clr-namespace:TextPipeline.Converters"
        Title="Операции" Height="646" Width="1156"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="264"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- ЛЕВАЯ ЧАСТЬ: Список операций -->
        <Border Grid.Column="0"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1.5"
                CornerRadius="10"
                Padding="10"
                Margin="0,0,15,0">
            <ListBox ItemsSource="{Binding Operations}"
                     SelectedItem="{Binding SelectedOperation}"
                     Background="Transparent"
                     BorderThickness="0" Margin="0,0,-12,0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}"
                                   FontSize="14"
                                   FontWeight="Medium"
                                   Padding="4,6"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- ПРАВАЯ ЧАСТЬ: Карточка операции -->
        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ContentControl Content="{Binding SelectedOperation}">
                <ContentControl.Resources>

                    <!--  НОРМАЛИЗАЦИЯ  -->
                    <DataTemplate DataType="{x:Type vm:NormalizeViewModel}">
                        <Border Background="{StaticResource CardBackgroundBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1.5"
                                CornerRadius="10"
                                Padding="25">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="140"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="140"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Входной текст:"
                                           FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>

                                <TextBox Grid.Row="1"
                                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="Wrap" AcceptsReturn="True"
                                         MaxLength="1000"
                                         VerticalScrollBarVisibility="Auto"/>

                                <Button Grid.Row="2" Content="Выполнить"
                                        Command="{Binding ExecuteCommand}"
                                        Background="{StaticResource SuccessButtonBrush}"
                                        Foreground="White"
                                        HorizontalAlignment="Left"
                                        Margin="0,15,0,15"/>

                                <StackPanel Grid.Row="3" Margin="0,0,0,15">
                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <Ellipse Width="14" Height="14"
                                                 Fill="{Binding IsPreSatisfied, Converter={StaticResource BoolToColor}}"
                                                 Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock VerticalAlignment="Center" FontSize="14">
                                            <Run Text="Предусловие: " FontWeight="SemiBold"/>
                                            <Run Text="{Binding IsPreSatisfied, Converter={StaticResource BoolToText}}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <Ellipse Width="14" Height="14"
                                                 Fill="{Binding IsPostSatisfied, Converter={StaticResource BoolToColor}}"
                                                 Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock VerticalAlignment="Center" FontSize="14">
                                            <Run Text="Постусловие: " FontWeight="SemiBold"/>
                                            <Run Text="{Binding IsPostSatisfied, Converter={StaticResource BoolToText}}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Grid.Row="4" Text="Результат:"
                                           FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>

                                <TextBox Grid.Row="5" Text="{Binding ResultText}"
                                         TextWrapping="Wrap" IsReadOnly="True"
                                         VerticalScrollBarVisibility="Auto"
                                         Background="#FAFBFC"/>

                                <Button Grid.Row="6" Content="Показать контракт"
                                        Click="ShowContract_Click"
                                        Background="{StaticResource PrimaryButtonBrush}"
                                        Foreground="White"
                                        HorizontalAlignment="Left"
                                        Margin="0,15,0,0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>

                    <!--  ФИЛЬТРАЦИЯ  -->
                    <DataTemplate DataType="{x:Type vm:FilterViewModel}">
                        <Border Background="{StaticResource CardBackgroundBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1.5"
                                CornerRadius="10"
                                Padding="25">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="140"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="140"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Входной текст:"
                                           FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>

                                <TextBox Grid.Row="1"
                                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="Wrap" AcceptsReturn="True"
                                         MaxLength="1000"
                                         VerticalScrollBarVisibility="Auto"/>

                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,10">
                                    <TextBlock Text="Фильтр: " VerticalAlignment="Center"
                                               FontWeight="SemiBold" Margin="0,0,10,0"/>
                                    <CheckBox Content="Буквы"
                                              IsChecked="{Binding FilterLetters}"
                                              Margin="0,0,15,0"/>
                                    <CheckBox Content="Цифры"
                                              IsChecked="{Binding FilterDigits}"
                                              Margin="0,0,15,0"/>
                                    <CheckBox Content="Прочие символы"
                                              IsChecked="{Binding FilterOthers}"/>
                                </StackPanel>

                                <Button Grid.Row="3" Content="Выполнить"
                                        Command="{Binding ExecuteCommand}"
                                        Background="{StaticResource SuccessButtonBrush}"
                                        Foreground="White"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,15"/>

                                <StackPanel Grid.Row="4" Margin="0,0,0,15">
                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <Ellipse Width="14" Height="14"
                                                 Fill="{Binding IsPreSatisfied, Converter={StaticResource BoolToColor}}"
                                                 Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock VerticalAlignment="Center" FontSize="14">
                                            <Run Text="Предусловие: " FontWeight="SemiBold"/>
                                            <Run Text="{Binding IsPreSatisfied, Converter={StaticResource BoolToText}}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <Ellipse Width="14" Height="14"
                                                 Fill="{Binding IsPostSatisfied, Converter={StaticResource BoolToColor}}"
                                                 Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock VerticalAlignment="Center" FontSize="14">
                                            <Run Text="Постусловие: " FontWeight="SemiBold"/>
                                            <Run Text="{Binding IsPostSatisfied, Converter={StaticResource BoolToText}}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Grid.Row="5" Text="Результат:"
                                           FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>

                                <TextBox Grid.Row="6" Text="{Binding ResultText}"
                                         TextWrapping="Wrap" IsReadOnly="True"
                                         VerticalScrollBarVisibility="Auto"
                                         Background="#FAFBFC"/>

                                <Button Grid.Row="7" Content="Показать контракт"
                                        Click="ShowContract_Click"
                                        Background="{StaticResource PrimaryButtonBrush}"
                                        Foreground="White"
                                        HorizontalAlignment="Left"
                                        Margin="0,15,0,0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>

                    <!--  МАСКА  -->
                    <DataTemplate DataType="{x:Type vm:MaskViewModel}">
                        <Border Background="{StaticResource CardBackgroundBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1.5"
                                CornerRadius="10"
                                Padding="25">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Входной текст:"
                                           FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>
                                <TextBox Grid.Row="1"
                                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="Wrap" AcceptsReturn="True"
                                         MaxLength="1000"
                                         VerticalScrollBarVisibility="Auto"
                                         Margin="0,0,0,15"/>

                                <TextBlock Grid.Row="2" Text="Маска (символ '#' — место подстановки):"
                                           FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>
                                <TextBox Grid.Row="3"
                                         Text="{Binding Mask, UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="Wrap" AcceptsReturn="True"
                                         MaxLength="1000"
                                         VerticalScrollBarVisibility="Auto"
                                         FontFamily="Consolas"
                                         Margin="0,0,0,15"/>

                                <Button Grid.Row="4" Content="Выполнить"
                                        Command="{Binding ExecuteCommand}"
                                        Background="{StaticResource SuccessButtonBrush}"
                                        Foreground="White"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,15"/>

                                <StackPanel Grid.Row="5" Margin="0,0,0,15">
                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <Ellipse Width="14" Height="14"
                                                 Fill="{Binding IsPreSatisfied, Converter={StaticResource BoolToColor}}"
                                                 Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock VerticalAlignment="Center" FontSize="14">
                                            <Run Text="Предусловие: " FontWeight="SemiBold"/>
                                            <Run Text="{Binding IsPreSatisfied, Converter={StaticResource BoolToText}}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <Ellipse Width="14" Height="14"
                                                 Fill="{Binding IsPostSatisfied, Converter={StaticResource BoolToColor}}"
                                                 Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock VerticalAlignment="Center" FontSize="14">
                                            <Run Text="Постусловие: " FontWeight="SemiBold"/>
                                            <Run Text="{Binding IsPostSatisfied, Converter={StaticResource BoolToText}}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Grid.Row="6" Text="Результат:"
                                           FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>
                                <TextBox Grid.Row="7" Text="{Binding ResultText}"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         FontFamily="Consolas"
                                         Background="#FAFBFC"
                                         Margin="0,0,0,15"/>

                                <Button Grid.Row="8" Content="Показать контракт"
                                        Click="ShowContract_Click"
                                        Background="{StaticResource PrimaryButtonBrush}"
                                        Foreground="White"
                                        HorizontalAlignment="Left"/>
                            </Grid>
                        </Border>
                    </DataTemplate>

                </ContentControl.Resources>
            </ContentControl>
        </ScrollViewer>
    </Grid>
</Window>
