<Window x:Class="TextPipeline.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TextPipeline.ViewModels"
        xmlns:conv="clr-namespace:TextPipeline.Converters"
        Title="Операции" Height="1000" Width="1156"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <TabControl Background="{StaticResource BackgroundBrush}">
        <!-- ВКЛАДКА Текстовый конвертер -->
        <TabItem Header="Текстовый конвертер">

            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="180*"/>
                    <RowDefinition Height="337*"/>
                    <RowDefinition Height="397*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="166.1"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- ЛЕВАЯ ЧАСТЬ: Список операций -->
                <Border Grid.Column="0"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1.5"
                CornerRadius="10"
                Padding="10"
                Margin="0,0,31,0" Grid.ColumnSpan="2" Grid.RowSpan="3">
                    <ListBox ItemsSource="{Binding Operations}"
                     SelectedItem="{Binding SelectedOperation}"
                     Background="Transparent"
                     BorderThickness="0" Margin="-6,0,-6,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}"
                                   FontSize="14"
                                   FontWeight="Medium"
                                   Padding="4,6"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- ПРАВАЯ ЧАСТЬ: Карточка операции -->
                <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Grid.ColumnSpan="2" Margin="264,0,0,0" Grid.RowSpan="3">
                    <ContentControl Content="{Binding SelectedOperation}">
                        <ContentControl.Resources>

                            <!--  НОРМАЛИЗАЦИЯ  -->
                            <DataTemplate DataType="{x:Type vm:NormalizeViewModel}">
                                <Border Background="{StaticResource CardBackgroundBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1.5"
                                CornerRadius="10"
                                Padding="25">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="140"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="140"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Text="Входной текст:"
                                           FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>

                                        <TextBox Grid.Row="1"
                                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="Wrap" AcceptsReturn="True"
                                         MaxLength="1000"
                                         VerticalScrollBarVisibility="Auto"/>

                                        <Button Grid.Row="2" Content="Выполнить"
                                        Command="{Binding ExecuteCommand}"
                                        Background="{StaticResource SuccessButtonBrush}"
                                        Foreground="White"
                                        HorizontalAlignment="Left"
                                        Margin="0,15,0,15"/>

                                        <StackPanel Grid.Row="3" Margin="0,0,0,15">
                                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                                <Ellipse Width="14" Height="14"
                                                 Fill="{Binding IsPreSatisfied, Converter={StaticResource BoolToColor}}"
                                                 Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                <TextBlock VerticalAlignment="Center" FontSize="14">
                                            <Run Text="Предусловие: " FontWeight="SemiBold"/>
                                            <Run Text="{Binding IsPreSatisfied, Converter={StaticResource BoolToText}}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                                <Ellipse Width="14" Height="14"
                                                 Fill="{Binding IsPostSatisfied, Converter={StaticResource BoolToColor}}"
                                                 Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                <TextBlock VerticalAlignment="Center" FontSize="14">
                                            <Run Text="Постусловие: " FontWeight="SemiBold"/>
                                            <Run Text="{Binding IsPostSatisfied, Converter={StaticResource BoolToText}}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock Grid.Row="4" Text="Результат:"
                                           FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>

                                        <TextBox Grid.Row="5" Text="{Binding ResultText}"
                                         TextWrapping="Wrap" IsReadOnly="True"
                                         VerticalScrollBarVisibility="Auto"
                                         Background="#FAFBFC"/>

                                        <Button Grid.Row="6" Content="Показать контракт"
                                        Click="ShowContract_Click"
                                        Background="{StaticResource PrimaryButtonBrush}"
                                        Foreground="White"
                                        HorizontalAlignment="Left"
                                        Margin="0,15,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>

                            <!--  ФИЛЬТРАЦИЯ  -->
                            <DataTemplate DataType="{x:Type vm:FilterViewModel}">
                                <Border Background="{StaticResource CardBackgroundBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1.5"
                                CornerRadius="10"
                                Padding="25">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="140"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="140"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Text="Входной текст:"
                                           FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>

                                        <TextBox Grid.Row="1"
                                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="Wrap" AcceptsReturn="True"
                                         MaxLength="1000"
                                         VerticalScrollBarVisibility="Auto"/>

                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,10">
                                            <TextBlock Text="Фильтр: " VerticalAlignment="Center"
                                               FontWeight="SemiBold" Margin="0,0,10,0"/>
                                            <CheckBox Content="Буквы"
                                              IsChecked="{Binding FilterLetters}"
                                              Margin="0,0,15,0"/>
                                            <CheckBox Content="Цифры"
                                              IsChecked="{Binding FilterDigits}"
                                              Margin="0,0,15,0"/>
                                            <CheckBox Content="Прочие символы"
                                              IsChecked="{Binding FilterOthers}"/>
                                        </StackPanel>

                                        <Button Grid.Row="3" Content="Выполнить"
                                        Command="{Binding ExecuteCommand}"
                                        Background="{StaticResource SuccessButtonBrush}"
                                        Foreground="White"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,15"/>

                                        <StackPanel Grid.Row="4" Margin="0,0,0,15">
                                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                                <Ellipse Width="14" Height="14"
                                                 Fill="{Binding IsPreSatisfied, Converter={StaticResource BoolToColor}}"
                                                 Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                <TextBlock VerticalAlignment="Center" FontSize="14">
                                            <Run Text="Предусловие: " FontWeight="SemiBold"/>
                                            <Run Text="{Binding IsPreSatisfied, Converter={StaticResource BoolToText}}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                                <Ellipse Width="14" Height="14"
                                                 Fill="{Binding IsPostSatisfied, Converter={StaticResource BoolToColor}}"
                                                 Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                <TextBlock VerticalAlignment="Center" FontSize="14">
                                            <Run Text="Постусловие: " FontWeight="SemiBold"/>
                                            <Run Text="{Binding IsPostSatisfied, Converter={StaticResource BoolToText}}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock Grid.Row="5" Text="Результат:"
                                           FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>

                                        <TextBox Grid.Row="6" Text="{Binding ResultText}"
                                         TextWrapping="Wrap" IsReadOnly="True"
                                         VerticalScrollBarVisibility="Auto"
                                         Background="#FAFBFC"/>

                                        <Button Grid.Row="7" Content="Показать контракт"
                                        Click="ShowContract_Click"
                                        Background="{StaticResource PrimaryButtonBrush}"
                                        Foreground="White"
                                        HorizontalAlignment="Left"
                                        Margin="0,15,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>

                            <!--  МАСКА  -->
                            <DataTemplate DataType="{x:Type vm:MaskViewModel}">
                                <Border Background="{StaticResource CardBackgroundBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1.5"
                                CornerRadius="10"
                                Padding="25">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Text="Входной текст:"
                                           FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>
                                        <TextBox Grid.Row="1"
                                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="Wrap" AcceptsReturn="True"
                                         MaxLength="1000"
                                         VerticalScrollBarVisibility="Auto"
                                         Margin="0,0,0,15"/>

                                        <TextBlock Grid.Row="2" Text="Маска (символ '#' — место подстановки):"
                                           FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>
                                        <TextBox Grid.Row="3"
                                         Text="{Binding Mask, UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="Wrap" AcceptsReturn="True"
                                         MaxLength="1000"
                                         VerticalScrollBarVisibility="Auto"
                                         FontFamily="Consolas"
                                         Margin="0,0,0,15"/>

                                        <Button Grid.Row="4" Content="Выполнить"
                                        Command="{Binding ExecuteCommand}"
                                        Background="{StaticResource SuccessButtonBrush}"
                                        Foreground="White"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,15"/>

                                        <StackPanel Grid.Row="5" Margin="0,0,0,15">
                                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                                <Ellipse Width="14" Height="14"
                                                 Fill="{Binding IsPreSatisfied, Converter={StaticResource BoolToColor}}"
                                                 Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                <TextBlock VerticalAlignment="Center" FontSize="14">
                                            <Run Text="Предусловие: " FontWeight="SemiBold"/>
                                            <Run Text="{Binding IsPreSatisfied, Converter={StaticResource BoolToText}}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                                <Ellipse Width="14" Height="14"
                                                 Fill="{Binding IsPostSatisfied, Converter={StaticResource BoolToColor}}"
                                                 Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                <TextBlock VerticalAlignment="Center" FontSize="14">
                                            <Run Text="Постусловие: " FontWeight="SemiBold"/>
                                            <Run Text="{Binding IsPostSatisfied, Converter={StaticResource BoolToText}}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock Grid.Row="6" Text="Результат:"
                                           FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>
                                        <TextBox Grid.Row="7" Text="{Binding ResultText}"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         FontFamily="Consolas"
                                         Background="#FAFBFC"
                                         Margin="0,0,0,15"/>

                                        <Button Grid.Row="8" Content="Показать контракт"
                                        Click="ShowContract_Click"
                                        Background="{StaticResource PrimaryButtonBrush}"
                                        Foreground="White"
                                        HorizontalAlignment="Left"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>

                        </ContentControl.Resources>
                    </ContentControl>
                </ScrollViewer>
            </Grid>
        </TabItem>
        <TabItem Header="Конструктор фрагмента">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                <Grid Margin="20" DataContext="{Binding WpViewModel}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Выбор примера -->
                    <ComboBox Grid.Row="0"
                 ItemsSource="{Binding Examples}"
                 SelectedItem="{Binding SelectedExample}"
                 DisplayMemberPath="Name"
                 Margin="0 0 0 10"
                 Width="300"/>

                    <!-- Цель (Post) -->
                    <GroupBox Grid.Row="1" Header="Цель (Post)">
                        <Grid Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBox Grid.Row="0"
                         Text="{Binding Postcondition}"
                         FontFamily="Consolas"
                         Margin="0 0 0 5"/>

                            <TextBox Grid.Row="1"
                         Text="{Binding PostconditionHuman}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"/>
                        </Grid>
                    </GroupBox>

                    <!-- Редактор кода -->
                    <GroupBox Grid.Row="2" Header="Код фрагмента">
                        <TextBox Text="{Binding ProgramText}"
                    AcceptsReturn="True"
                    FontFamily="Consolas"
                    Height="150"
                    Margin="5"/>
                    </GroupBox>

                    <!-- Кнопки управления -->
                    <StackPanel 
                        Grid.Row="3" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Center"
                        Margin="0,20,0,10">

                        <Button 
                            Content="Рассчитать wp"
                            Command="{Binding CalculateCommand}"
                            Margin="0 0 10 0"
                            Background="{StaticResource SuccessButtonBrush}"
                            Width="150"
                            Height="44" MinHeight="35" Padding="5"/>    

                        <Button 
                            Content="Показать триаду"
                            Command="{Binding ShowTriadCommand}"
                            IsEnabled="{Binding IsSuccess}"
                            Background="{StaticResource PrimaryButtonBrush}"
                            Width="150"
                            Height="44"
                            MinHeight="35"
                            Padding="5"/>
                    </StackPanel>

                    <!-- Основная область -->
                    <Grid Grid.Row="4" Margin="0 10 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="418"/>
                        </Grid.ColumnDefinitions>

                        <!-- Шаги вычисления -->
                        <Border Grid.Column="0" Padding="5" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                            <TextBox Text="{Binding StepsText, Mode=OneWay}"
                           FontFamily="Consolas"
                           Margin="5"
                           TextWrapping="Wrap"/>
                        </Border>

                        <!-- Результаты -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Предусловие -->
                            <GroupBox Grid.Row="0" Header="Слабейшее предусловие (wp)">
                                <Grid Margin="5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>

                                    <TextBox Grid.Row="0"
                                Text="{Binding Precondition, Mode=OneWay}"
                                TextWrapping="Wrap"
                                IsReadOnly="True"
                                FontFamily="Consolas"
                                Margin="0 0 0 5"/>
                                </Grid>
                            </GroupBox>

                            <GroupBox Grid.Row="1" Header="Триада Хоара">
                                <Grid Margin="5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>

                                    <TextBox Grid.Row="0"
                                    Text="{Binding TriadShort}"
                                    TextWrapping="Wrap"
                                    IsReadOnly="True"
                                    FontFamily="Consolas"
                                    Margin="0 0 0 5"/>
                                </Grid>
                            </GroupBox>


                            <!-- Условия определённости -->
                            <GroupBox Grid.Row="2" Header="Условия определённости">
                                <TextBox Text="{Binding DefinednessConditionsText, Mode=OneWay}"
            IsReadOnly="True"
            FontFamily="Consolas"
            TextWrapping="Wrap"
            Margin="5"/>
                            </GroupBox>

                            <!-- Сообщения об ошибках -->
                            <TextBlock Grid.Row="3"
          Foreground="Red"
          Text="{Binding ErrorMessage}"/>
                        </Grid>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>