<Window x:Class="TextPipeline.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TextPipeline.ViewModels"
        xmlns:conv="clr-namespace:TextPipeline.Converters"
        Title="Операции" Height="800" Width="1156"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <TabControl Background="{StaticResource BackgroundBrush}">
        <!-- ВКЛАДКА Текстовый конвертер -->
        <TabItem Header="Текстовый конвертер">

            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="180*"/>
                    <RowDefinition Height="337*"/>
                    <RowDefinition Height="397*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="166.1"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- ЛЕВАЯ ЧАСТЬ: Список операций -->
                <Border Grid.Column="0"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1.5"
                CornerRadius="10"
                Padding="10"
                Margin="0,0,31,0" Grid.ColumnSpan="2" Grid.RowSpan="3">
                    <ListBox ItemsSource="{Binding Operations}"
                     SelectedItem="{Binding SelectedOperation}"
                     Background="Transparent"
                     BorderThickness="0" Margin="-6,0,-6,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}"
                                   FontSize="14"
                                   FontWeight="Medium"
                                   Padding="4,6"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- ПРАВАЯ ЧАСТЬ: Карточка операции -->
                <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Grid.ColumnSpan="2" Margin="264,0,0,0" Grid.RowSpan="3">
                    <ContentControl Content="{Binding SelectedOperation}">
                        <ContentControl.Resources>

                            <!--  НОРМАЛИЗАЦИЯ  -->
                            <DataTemplate DataType="{x:Type vm:NormalizeViewModel}">
                                <Border Background="{StaticResource CardBackgroundBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1.5"
                                CornerRadius="10"
                                Padding="25">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="140"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="140"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Text="Входной текст:"
                                           FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>

                                        <TextBox Grid.Row="1"
                                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="Wrap" AcceptsReturn="True"
                                         MaxLength="1000"
                                         VerticalScrollBarVisibility="Auto"/>

                                        <Button Grid.Row="2" Content="Выполнить"
                                        Command="{Binding ExecuteCommand}"
                                        Background="{StaticResource SuccessButtonBrush}"
                                        Foreground="White"
                                        HorizontalAlignment="Left"
                                        Margin="0,15,0,15"/>

                                        <StackPanel Grid.Row="3" Margin="0,0,0,15">
                                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                                <Ellipse Width="14" Height="14"
                                                 Fill="{Binding IsPreSatisfied, Converter={StaticResource BoolToColor}}"
                                                 Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                <TextBlock VerticalAlignment="Center" FontSize="14">
                                            <Run Text="Предусловие: " FontWeight="SemiBold"/>
                                            <Run Text="{Binding IsPreSatisfied, Converter={StaticResource BoolToText}}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                                <Ellipse Width="14" Height="14"
                                                 Fill="{Binding IsPostSatisfied, Converter={StaticResource BoolToColor}}"
                                                 Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                <TextBlock VerticalAlignment="Center" FontSize="14">
                                            <Run Text="Постусловие: " FontWeight="SemiBold"/>
                                            <Run Text="{Binding IsPostSatisfied, Converter={StaticResource BoolToText}}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock Grid.Row="4" Text="Результат:"
                                           FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>

                                        <TextBox Grid.Row="5" Text="{Binding ResultText}"
                                         TextWrapping="Wrap" IsReadOnly="True"
                                         VerticalScrollBarVisibility="Auto"
                                         Background="#FAFBFC"/>

                                        <Button Grid.Row="6" Content="Показать контракт"
                                        Click="ShowContract_Click"
                                        Background="{StaticResource PrimaryButtonBrush}"
                                        Foreground="White"
                                        HorizontalAlignment="Left"
                                        Margin="0,15,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>

                            <!--  ФИЛЬТРАЦИЯ  -->
                            <DataTemplate DataType="{x:Type vm:FilterViewModel}">
                                <Border Background="{StaticResource CardBackgroundBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1.5"
                                CornerRadius="10"
                                Padding="25">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="140"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="140"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Text="Входной текст:"
                                           FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>

                                        <TextBox Grid.Row="1"
                                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="Wrap" AcceptsReturn="True"
                                         MaxLength="1000"
                                         VerticalScrollBarVisibility="Auto"/>

                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,10">
                                            <TextBlock Text="Фильтр: " VerticalAlignment="Center"
                                               FontWeight="SemiBold" Margin="0,0,10,0"/>
                                            <CheckBox Content="Буквы"
                                              IsChecked="{Binding FilterLetters}"
                                              Margin="0,0,15,0"/>
                                            <CheckBox Content="Цифры"
                                              IsChecked="{Binding FilterDigits}"
                                              Margin="0,0,15,0"/>
                                            <CheckBox Content="Прочие символы"
                                              IsChecked="{Binding FilterOthers}"/>
                                        </StackPanel>

                                        <Button Grid.Row="3" Content="Выполнить"
                                        Command="{Binding ExecuteCommand}"
                                        Background="{StaticResource SuccessButtonBrush}"
                                        Foreground="White"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,15"/>

                                        <StackPanel Grid.Row="4" Margin="0,0,0,15">
                                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                                <Ellipse Width="14" Height="14"
                                                 Fill="{Binding IsPreSatisfied, Converter={StaticResource BoolToColor}}"
                                                 Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                <TextBlock VerticalAlignment="Center" FontSize="14">
                                            <Run Text="Предусловие: " FontWeight="SemiBold"/>
                                            <Run Text="{Binding IsPreSatisfied, Converter={StaticResource BoolToText}}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                                <Ellipse Width="14" Height="14"
                                                 Fill="{Binding IsPostSatisfied, Converter={StaticResource BoolToColor}}"
                                                 Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                <TextBlock VerticalAlignment="Center" FontSize="14">
                                            <Run Text="Постусловие: " FontWeight="SemiBold"/>
                                            <Run Text="{Binding IsPostSatisfied, Converter={StaticResource BoolToText}}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock Grid.Row="5" Text="Результат:"
                                           FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>

                                        <TextBox Grid.Row="6" Text="{Binding ResultText}"
                                         TextWrapping="Wrap" IsReadOnly="True"
                                         VerticalScrollBarVisibility="Auto"
                                         Background="#FAFBFC"/>

                                        <Button Grid.Row="7" Content="Показать контракт"
                                        Click="ShowContract_Click"
                                        Background="{StaticResource PrimaryButtonBrush}"
                                        Foreground="White"
                                        HorizontalAlignment="Left"
                                        Margin="0,15,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>

                            <!--  МАСКА  -->
                            <DataTemplate DataType="{x:Type vm:MaskViewModel}">
                                <Border Background="{StaticResource CardBackgroundBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1.5"
                                CornerRadius="10"
                                Padding="25">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Text="Входной текст:"
                                           FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>
                                        <TextBox Grid.Row="1"
                                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="Wrap" AcceptsReturn="True"
                                         MaxLength="1000"
                                         VerticalScrollBarVisibility="Auto"
                                         Margin="0,0,0,15"/>

                                        <TextBlock Grid.Row="2" Text="Маска (символ '#' — место подстановки):"
                                           FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>
                                        <TextBox Grid.Row="3"
                                         Text="{Binding Mask, UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="Wrap" AcceptsReturn="True"
                                         MaxLength="1000"
                                         VerticalScrollBarVisibility="Auto"
                                         FontFamily="Consolas"
                                         Margin="0,0,0,15"/>

                                        <Button Grid.Row="4" Content="Выполнить"
                                        Command="{Binding ExecuteCommand}"
                                        Background="{StaticResource SuccessButtonBrush}"
                                        Foreground="White"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,15"/>

                                        <StackPanel Grid.Row="5" Margin="0,0,0,15">
                                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                                <Ellipse Width="14" Height="14"
                                                 Fill="{Binding IsPreSatisfied, Converter={StaticResource BoolToColor}}"
                                                 Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                <TextBlock VerticalAlignment="Center" FontSize="14">
                                            <Run Text="Предусловие: " FontWeight="SemiBold"/>
                                            <Run Text="{Binding IsPreSatisfied, Converter={StaticResource BoolToText}}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                                <Ellipse Width="14" Height="14"
                                                 Fill="{Binding IsPostSatisfied, Converter={StaticResource BoolToColor}}"
                                                 Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                <TextBlock VerticalAlignment="Center" FontSize="14">
                                            <Run Text="Постусловие: " FontWeight="SemiBold"/>
                                            <Run Text="{Binding IsPostSatisfied, Converter={StaticResource BoolToText}}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock Grid.Row="6" Text="Результат:"
                                           FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>
                                        <TextBox Grid.Row="7" Text="{Binding ResultText}"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         FontFamily="Consolas"
                                         Background="#FAFBFC"
                                         Margin="0,0,0,15"/>

                                        <Button Grid.Row="8" Content="Показать контракт"
                                        Click="ShowContract_Click"
                                        Background="{StaticResource PrimaryButtonBrush}"
                                        Foreground="White"
                                        HorizontalAlignment="Left"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>

                        </ContentControl.Resources>
                    </ContentControl>
                </ScrollViewer>
            </Grid>
        </TabItem>
        <TabItem Header="Конструктор фрагмента">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                <Grid Margin="20" DataContext="{Binding WpViewModel}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Выбор примера -->
                    <ComboBox Grid.Row="0"
                         ItemsSource="{Binding Examples}"
                         SelectedItem="{Binding SelectedExample}"
                         DisplayMemberPath="Name"
                         Margin="0 0 0 10"
                         Width="300"/>

                    <!-- Цель (Post) -->
                    <GroupBox Grid.Row="1" Header="Цель (Post)">
                        <Grid Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBox Grid.Row="0"
                                 Text="{Binding Postcondition}"
                                 FontFamily="Consolas"
                                 Margin="0 0 0 5"/>

                            <TextBox Grid.Row="1"
                                 Text="{Binding PostconditionHuman}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"/>
                        </Grid>
                    </GroupBox>

                    <!-- Редактор кода -->
                    <GroupBox Grid.Row="2" Header="Код фрагмента">
                        <TextBox Text="{Binding ProgramText}"
                            AcceptsReturn="True"
                            FontFamily="Consolas"
                            Height="150"
                            Margin="5"/>
                    </GroupBox>

                    <!-- Кнопки управления -->
                    <StackPanel 
                        Grid.Row="3" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Center"
                        Margin="0,20,0,10">

                        <Button 
                            Content="Рассчитать wp"
                            Command="{Binding CalculateCommand}"
                            Margin="0 0 10 0"
                            Background="{StaticResource SuccessButtonBrush}"
                            Width="150"
                            Height="44" MinHeight="35" Padding="5">
                            <Button.ToolTip>
                                <ToolTip Background="#212121" Foreground="White" Padding="10" FontSize="14">
                                    <TextBlock Text="Рассчитать слабейшее предусловие (wp) - это процесс автоматического вычисления начального условия, при котором программа гарантированно достигнет заданного конечного состояния (постусловия)"/>
                                </ToolTip>
                            </Button.ToolTip>
                        </Button>

                        <Button 
                            Content="Показать триаду"
                            Command="{Binding ShowTriadCommand}"
                            IsEnabled="{Binding IsSuccess}"
                            Background="{StaticResource PrimaryButtonBrush}"
                            Width="150"
                            Height="44"
                            MinHeight="35"
                            Padding="5">
                            <Button.ToolTip>
                                <ToolTip Background="#212121" Foreground="White" Padding="10" FontSize="14">
                                    <TextBlock Text="Триада Хоара - это формальное представление {Предусловие} Программа {Постусловие}, которое показывает связь между начальным и конечным состоянием программы"/>
                                </ToolTip>
                            </Button.ToolTip>
                        </Button>
                    </StackPanel>

                    <!-- Основная область -->
                    <Grid Grid.Row="4" Margin="0 10 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="418"/>
                        </Grid.ColumnDefinitions>

                        <!-- Шаги вычисления -->
                        <GroupBox Grid.Column="0" Header="Пошаговые вычисления">
                            <TextBox Text="{Binding StepsText, Mode=OneWay}"
                                   FontFamily="Consolas"
                                   Margin="5"
                                   TextWrapping="Wrap"/>
                        </GroupBox>

                        <!-- Результаты -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Предусловие -->
                            <GroupBox Grid.Row="0" Header="Слабейшее предусловие (wp)">
                                <Grid Margin="5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>

                                    <TextBox Grid.Row="0"
                                        Text="{Binding Precondition, Mode=OneWay}"
                                        TextWrapping="Wrap"
                                        IsReadOnly="True"
                                        FontFamily="Consolas"
                                        Margin="0 0 0 5"/>
                                </Grid>
                            </GroupBox>

                            <GroupBox Grid.Row="1" Header="Триада Хоара">
                                <Grid Margin="5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>

                                    <TextBox Grid.Row="0"
                                        Text="{Binding TriadShort}"
                                        TextWrapping="Wrap"
                                        IsReadOnly="True"
                                        FontFamily="Consolas"
                                        Margin="0 0 0 5"/>
                                </Grid>
                            </GroupBox>


                            <!-- Условия определённости -->
                            <GroupBox Grid.Row="2" Header="Условия определённости" Visibility="{Binding HasDefinednessConditions, Converter={StaticResource BoolToVisibility}}">

                                <TextBox Text="{Binding DefinednessConditionsText, Mode=OneWay}"
                                    IsReadOnly="True"
                                    FontFamily="Consolas"
                                    TextWrapping="Wrap"
                                    Margin="5"/>
                            </GroupBox>

                            <!-- Сообщения об ошибках -->
                            <TextBlock Grid.Row="2"
                                Foreground="Red"
                                Text="{Binding ErrorMessage}" TextWrapping="Wrap" Margin="10,74,0,-106" Grid.RowSpan="2" FontSize="20"/>
                        </Grid>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="Циклы">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Панель Данных -->
                        <RowDefinition Height="Auto"/>
                        <!-- Выбор режима -->
                        <RowDefinition Height="Auto"/>
                        <!-- Управление -->
                        <RowDefinition Height="*"/>
                        <!-- Таблица массива -->
                        <RowDefinition Height="Auto"/>
                        <!-- Инварианты и Вариант -->
                        <RowDefinition Height="Auto"/>
                        <!-- Проверка WP -->
                    </Grid.RowDefinitions>

                    <!-- 2.1. Панель «Данные» -->
                    <GroupBox Header="Генератор данных" Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Длина (N):" VerticalAlignment="Center" Margin="5,0"/>
                            <TextBox Text="{Binding ArrayLength}" Width="60" Margin="5,0"/>

                            <TextBlock Text="Мин:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                            <TextBox Text="{Binding MinValue}" Width="60" Margin="0,0,5,0"/>

                            <TextBlock Text="Макс:" VerticalAlignment="Center" Margin="5,0"/>
                            <TextBox Text="{Binding MaxValue}" Width="60" Margin="5,0"/>

                            <TextBlock Text="Порог (T):" VerticalAlignment="Center" Margin="10,0,5,0"/>
                            <TextBox Text="{Binding Threshold}" Width="60" Margin="0,0,5,0"/>

                            <Button Content="Сгенерировать" Command="{Binding GenerateCommand}" Margin="10,0"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- 2.2. Режимы -->
                    <GroupBox Header="Режим алгоритма" Grid.Row="1" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="PrefixSum (Сумма)" IsChecked="{Binding IsPrefixSumMode}" GroupName="AlgoMode" Margin="5"/>
                            <RadioButton Content="Count > T (Счетчик)" IsChecked="{Binding IsCountMode}" GroupName="AlgoMode" Margin="5"/>
                            <RadioButton Content="PrefixMax (Максимум)" IsChecked="{Binding IsMaxMode}" GroupName="AlgoMode" Margin="5"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- 2.3. Исполнение -->
                    <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <Button Content="Сброс" Command="{Binding ResetCommand}" Width="80" Margin="5"/>
                        <Button Content="Шаг" Command="{Binding StepCommand}" Width="80" Margin="5"/>
                        <Button Content="Пуск" Command="{Binding RunCommand}" Width="80" Margin="5"/>

                        <TextBlock Text="Индекс j:" VerticalAlignment="Center" Margin="15,0,5,0" FontWeight="Bold"/>
                        <TextBlock Text="{Binding CurrentIndex}" VerticalAlignment="Center" Width="30" Background="LightYellow"/>
                    </StackPanel>

                    <!-- Таблица массива (Редактируемая) -->
                    <GroupBox Header="Массив A[]" Grid.Row="3" Margin="0,0,0,10">
                        <DataGrid ItemsSource="{Binding ArrayItems}" 
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False"
                          IsReadOnly="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Индекс" Binding="{Binding Index}" IsReadOnly="True" Width="50"/>
                                <DataGridTextColumn Header="Значение" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            </DataGrid.Columns>
                            <!-- Стиль для подсветки текущей ячейки и измененных -->
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <!-- Подсветка текущего индекса j -->
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter Property="Background" Value="#FFFFE0"/>
                                            <!-- Светло-желтый -->
                                            <Setter Property="BorderBrush" Value="Orange"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </DataTrigger>
                                        <!-- Подсветка измененных ячеек (если есть свойство IsModified) -->
                                        <DataTrigger Binding="{Binding IsModified}" Value="True">
                                            <Setter Property="Background" Value="#FFD0F0C0"/>
                                            <!-- Светло-зеленый -->
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                        </DataGrid>
                    </GroupBox>

                    <!-- 2.4. Блок «Инвариант и вариант» -->
                    <GroupBox Header="Инвариант и Вариант-функция" Grid.Row="4" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Левая часть: Инвариант -->
                            <StackPanel Grid.Column="0" Margin="5">
                                <TextBlock Text="Инвариант (словами):" FontWeight="Bold"/>
                                <TextBox Text="{Binding InvariantText}" IsReadOnly="True" TextWrapping="Wrap" Height="60" Margin="0,2"/>

                                <TextBlock Text="Инвариант (формула):" FontWeight="Bold" Margin="0,5,0,0"/>
                                <TextBox Text="{Binding InvariantFormula}" IsReadOnly="True" FontFamily="Consolas" Margin="0,2"/>

                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <TextBlock Text="Истинность до шага:" Margin="0,0,5,0"/>
                                    <Ellipse Width="15" Height="15" Fill="{Binding InvariantBeforeColor}" Stroke="Gray" ToolTip="Состояние инварианта перед выполнением тела цикла"/>

                                    <TextBlock Text="Истинность после шага:" Margin="15,0,5,0"/>
                                    <Ellipse Width="15" Height="15" Fill="{Binding InvariantAfterColor}" Stroke="Gray" ToolTip="Состояние инварианта после выполнения тела цикла"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Правая часть: Вариант-функция -->
                            <StackPanel Grid.Column="1" Margin="5">
                                <TextBlock Text="Вариант-функция t(j):" FontWeight="Bold"/>
                                <TextBox Text="{Binding VariantFunctionFormula}" IsReadOnly="True" FontFamily="Consolas" Margin="0,2"/>

                                <TextBlock Text="Текущее значение t:" Margin="0,5,0,0"/>
                                <ProgressBar Minimum="0" Maximum="{Binding MaxVariantValue}" Value="{Binding CurrentVariantValue}" Height="20" Margin="0,2">
                                    <ProgressBar.ToolTip>
                                        <ToolTip>
                                            <StackPanel>
                                                <TextBlock Text="Прогресс убывания вариант-функции"/>
                                                <TextBlock Text="Должна строго убывать и быть >= 0"/>
                                            </StackPanel>
                                        </ToolTip>
                                    </ProgressBar.ToolTip>
                                </ProgressBar>
                                <TextBlock Text="{Binding CurrentVariantValue}" HorizontalAlignment="Right" FontSize="10"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <!-- 2.5. Блок «Проверка сохранения (wp)» -->
                    <GroupBox Header="Формальная проверка корректности" Grid.Row="5">
                        <StackPanel>
                            <!-- Формула wp -->
                            <TextBlock Text="Условие сохранения: (Inv ∧ B) ⇒ wp(S, Inv)" 
                               FontWeight="Bold" FontFamily="Consolas" Margin="0,0,0,5"/>

                            <!-- Список 4 условий -->
                            <ItemsControl ItemsSource="{Binding CorrectnessConditions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <!-- Галочка или крестик -->
                                            <TextBlock Text="{Binding StatusSymbol}" 
                                               Foreground="{Binding StatusColor}" 
                                               FontWeight="Bold" Width="20"/>
                                            <TextBlock Text="{Binding Description}" Margin="5,0"/>
                                            <!-- Всплывающая подсказка с определением -->
                                            <StackPanel.ToolTip>
                                                <ToolTip>
                                                    <TextBlock Text="{Binding Definition}" TextWrapping="Wrap" Width="200"/>
                                                </ToolTip>
                                            </StackPanel.ToolTip>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- 2.6. Блок «Проверка определённости (Def)» -->
                            <GroupBox Header="Условия определённости (Def)" Grid.Row="5" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Ограничения на данные и операции:" FontWeight="Bold" Margin="0,0,0,5"/>

                                    <!-- Список условий Def -->
                                    <ItemsControl ItemsSource="{Binding DefConditions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                    <!-- Индикатор статуса -->
                                                    <TextBlock Text="{Binding StatusSymbol}" 
                                   Foreground="{Binding StatusColor}" 
                                   FontWeight="Bold" Width="20"/>

                                                    <!-- Описание условия -->
                                                    <TextBlock Text="{Binding Description}" Margin="5,0"/>

                                                    <!-- Всплывающая подсказка с математическим обоснованием -->
                                                    <StackPanel.ToolTip>
                                                        <ToolTip>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Definition}" TextWrapping="Wrap" Width="250"/>
                                                                <TextBlock Text="Требуется для корректного вычисления wp(S, Inv)" FontStyle="Italic" Margin="0,5,0,0"/>
                                                            </StackPanel>
                                                        </ToolTip>
                                                    </StackPanel.ToolTip>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Итоговый статус определённости -->
                                    <Border Background="{Binding DefOverallColor}" Padding="5" Margin="0,5,0,0" CornerRadius="3">
                                        <TextBlock Text="{Binding DefOverallStatus}" 
                       HorizontalAlignment="Center" 
                       FontWeight="Bold" 
                       Foreground="White"/>
                                    </Border>
                                </StackPanel>
                            </GroupBox>

                            <!-- Разбор формулы словами -->
                            <TextBlock Text="{Binding WpExplanation}" TextWrapping="Wrap" Margin="0,10,0,0" FontStyle="Italic" Foreground="DarkSlateGray"/>
                        </StackPanel>
                    </GroupBox>

                </Grid>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>